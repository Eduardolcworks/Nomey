      "source": "contrato del dominio",
      "scope": "domain",
      "given": { "effectiveDate": "2026-13-01" },
      "expectError": "EFFECTIVE_DATE_INVALID"
    },
    {
      "id": "dia-cero",
      "source": "contrato del dominio",
      "scope": "domain",
      "given": { "effectiveDate": "2026-09-00" },
      "expectError": "EFFECTIVE_DATE_INVALID"
    },
    {
      "id": "sin-ceros",
      "source": "contrato del dominio",
