      "verificado",
      "root",
      "system",
      "sistema",
      "join",
      "pay",
      "auth",
      "recovery",
      "api",
      "app",
      "null",
      "anonymous",
      "anonimo",
      "invitado",
      "guest"
    ],
    "prefixes": ["nomey", "admin", "support", "soporte"]
  },
