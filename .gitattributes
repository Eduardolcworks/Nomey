# Normalise line endings so diffs stay clean across macOS/Linux/Windows.
# Without this, core.autocrlf on Windows warns on every commit and can
# produce whole-file diffs when contributors use different platforms.
* text=auto eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.p8 binary
*.p12 binary
*.jks binary
*.keystore binary
*.mobileprovision binary

# Generated: collapse in GitHub diffs.
package-lock.json linguist-generated=true diff=json
