# Nomey - environment variables template
#
# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored and must NEVER be committed.
#
# -----------------------------------------------------------------------------
# SECURITY - read before adding anything here
# -----------------------------------------------------------------------------
# Every variable prefixed with EXPO_PUBLIC_ is INLINED INTO THE APP BUNDLE and is
# readable by anyone who downloads the .ipa/.apk. That is acceptable for the
# Supabase URL and anon key, which are public by design and protected by RLS.
#
# NEVER add the service role key to this file or to any client-side variable.
# It bypasses Row Level Security entirely and would expose every user's
# financial data. It belongs only in Edge Functions and GitHub Secrets.
#
#   FORBIDDEN:  EXPO_PUBLIC_SUPABASE_SERVICE_ROLE_KEY=...
# -----------------------------------------------------------------------------

# Supabase (not connected yet - placeholders only)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
